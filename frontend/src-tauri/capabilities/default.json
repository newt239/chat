{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "すべてのプラットフォームでメインウィンドウに許可する操作",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "notification:default",
    "core:window:allow-set-badge-count",
    "os:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
