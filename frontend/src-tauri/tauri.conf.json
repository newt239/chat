{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chat",
  "version": "0.1.0",
  "identifier": "dev.newt239.chat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:tauri-web",
    "beforeBuildCommand": "pnpm build:tauri-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chat",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' https: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Chat",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
