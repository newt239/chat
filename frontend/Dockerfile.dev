FROM node:26-alpine

WORKDIR /app

# Copy workspace configuration
COPY pnpm-workspace.yaml package.json ./

# packageManager と同じ版を入れる。pnpm が自分で切り替えると minimumReleaseAge に阻まれる。Node は devEngines の版へ自動で切り替わる
RUN npm install -g "$(node -p "require('./package.json').packageManager")"
COPY pnpm-lock.yaml ./

# Copy all workspace package.json files to satisfy pnpm workspace
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/i18n/package.json ./packages/i18n/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy frontend source code
COPY packages ./packages
COPY frontend ./frontend

WORKDIR /app/frontend

# Expose port
EXPOSE 5173

# Run dev server (install dependencies first in case volumes are empty)
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run dev"]
