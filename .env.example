# PostgreSQL設定
POSTGRES_PASSWORD=your_secure_password_here

# JWT設定
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# 認証設定
# Google ログインの OAuth クライアント ID。バックエンドとフロントで同じ値を使う
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Tauri のアプリの Google ログイン用。同じ Web クライアントのシークレットと、承認済みのリダイレクト URI に登録したコールバック
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/oauth/google/callback
# パスワード認証。production では既定で無効
PASSWORD_AUTH_ENABLED=false

# Wasabi S3設定
WASABI_ACCESS_KEY_ID=your_wasabi_access_key
WASABI_SECRET_ACCESS_KEY=your_wasabi_secret_key
WASABI_BUCKET=your_bucket_name
WASABI_REGION=ap-northeast-1
WASABI_ENDPOINT=https://ap-northeast-1.s3.wasabisys.com

# Redis。複数レプリカで WebSocket の配信・閲覧者一覧・Webhook のレート制限を共有する。空ならプロセス内で完結する
REDIS_URL=redis://localhost:6379

# DB の接続プール
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
