{
  "name": "chat",
  "private": true,
  "scripts": {
    "start": "./scripts/dev.sh",
    "stop": "docker compose down",
    "public": "./scripts/tunnel.sh on",
    "private": "./scripts/tunnel.sh off",
    "tunnel:status": "./scripts/tunnel.sh status",
    "logs": "docker compose logs -f",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "knip": "turbo run knip",
    "codecheck": "turbo run codecheck",
    "clean": "./scripts/clean.sh",
    "claude": "claude --setting-sources project,local --permission-mode bypassPermissions",
    "generate:proto": "buf generate proto --template proto/buf.gen.yaml",
    "proto:format": "buf format -w proto",
    "proto:lint": "buf lint proto",
    "db:reset": "docker compose run --rm reset",
    "db:seed:bulk": "docker compose exec backend go run cmd/seed/main.go"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "lefthook": "2.1.14",
    "portless": "0.15.6",
    "turbo": "2.11.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
