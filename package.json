{
  "name": "chat",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "knip": "turbo run knip",
    "codecheck": "turbo run codecheck",
    "clean": "./scripts/clean.sh",
    "claude": "claude --setting-sources project,local",
    "migrate:generate": "docker-compose exec backend go run cmd/migrate/main.go",
    "generate:proto": "buf generate",
    "proto:format": "buf format -w",
    "proto:lint": "buf lint"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "lefthook": "2.1.14",
    "turbo": "2.10.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
