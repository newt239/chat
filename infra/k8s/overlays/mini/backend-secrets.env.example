# Neon の直接のエンドポイント（ホスト名に -pooler が付かないほう）を sslmode=require で指定する
DATABASE_URL=postgresql://chat:password@ep-example-123456.ap-northeast-1.aws.neon.tech/chat?sslmode=require
# どちらも openssl rand -hex 32 などで作る。Meilisearch のキーは 16 バイト以上必要
JWT_SECRET=change-me
MEILISEARCH_API_KEY=change-me
WASABI_ACCESS_KEY_ID=your_wasabi_access_key
WASABI_SECRET_ACCESS_KEY=your_wasabi_secret_key
